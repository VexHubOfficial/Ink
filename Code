--==================================================
-- BRING ALL TO PLAYER
--==================================================

bringAll.MouseButton1Click:Connect(function()
	local character = player.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local parts = getParts()

	if #parts == 0 then
		return
	end

	for _, part in ipairs(parts) do
		if part and part.Parent then
			part.Anchored = false
		end
	end

	task.spawn(function()
		local startTime = os.clock()

		while os.clock() - startTime < bringDuration do
			if not root.Parent then
				break
			end

			for _, part in ipairs(parts) do
				if part and part.Parent then

					part.Anchored = false

					local offset =
						root.Position - part.Position

					local distance =
						offset.Magnitude

					if distance > 3 then
						part.AssemblyLinearVelocity =
							offset.Unit *
							math.min(
								distance * 10,
								bringSpeed
							)
					else
						part.AssemblyLinearVelocity =
							Vector3.zero
					end

					part.AssemblyAngularVelocity =
						Vector3.zero
				end
			end

			RunService.Heartbeat:Wait()
		end
	end)
end)

