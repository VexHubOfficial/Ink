local function RemovePermanentHighlight(player)
	local character = player.Character

	if not character then
		return
	end

	local highlight =
		character:FindFirstChild("MalevolentPermanent")

	if highlight then
		highlight:Destroy()
	end
end

local function ApplyPermanentHighlight(player)
	if not player or not PermanentPlayers[player] then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	-- Remove normal ESP first.
	RemoveESPHighlight(player)

	local highlight =
		character:FindFirstChild("MalevolentPermanent")

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "MalevolentPermanent"
		highlight.Adornee = character
		highlight.FillTransparency = 0.35
		highlight.OutlineTransparency = 0
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
	end

	highlight.FillColor = PURPLE
	highlight.OutlineColor = PURPLE
end

local function FindUsername(username)
	if username == "" then
		return nil
	end

	local wanted = string.lower(username)

	for _, player in ipairs(Players:GetPlayers()) do
		if string.lower(player.Name) == wanted then
			return player
		end
	end

	return nil
end

InsertUserButton.MouseButton1Click:Connect(function()
	local player = FindUsername(PermanentBox.Text)

	if not player then
		return
	end

	-- Already inserted
	if PermanentPlayers[player] then
		ApplyPermanentHighlight(player)
		return
	end

	PermanentPlayers[player] = true

	ApplyPermanentHighlight(player)

	-- One respawn connection per permanent player
	PermanentConnections[player] =
		player.CharacterAdded:Connect(function()
			task.wait(0.25)

			if PermanentPlayers[player] then
				ApplyPermanentHighlight(player)
			end
		end)
end)

--==================================================
-- HIGHLIGHT MAINTENANCE
--==================================================

-- Handles team changes immediately
for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then

		player:GetPropertyChangedSignal("Team"):Connect(function()
			if IsESP() and not PermanentPlayers[player] then
				ApplyESPHighlight(player)
			end
		end)

		player.CharacterAdded:Connect(function()
			task.wait(0.25)

			if PermanentPlayers[player] then
				ApplyPermanentHighlight(player)
			elseif IsESP() then
				ApplyESPHighlight(player)
			end
		end)
	end
end

Players.PlayerAdded:Connect(function(player)
	if player == LocalPlayer then
		return
	end

	player:GetPropertyChangedSignal("Team"):Connect(function()
		if IsESP() and not PermanentPlayers[player] then
			ApplyESPHighlight(player)
		end
	end)

	player.CharacterAdded:Connect(function()
		task.wait(0.25)

		if PermanentPlayers[player] then
			ApplyPermanentHighlight(player)
		elseif IsESP() then
			ApplyESPHighlight(player)
		end
	end)

	if IsESP() then
		task.defer(function()
			ApplyESPHighlight(player)
		end)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	PermanentPlayers[player] = nil

	if PermanentConnections[player] then
		PermanentConnections[player]:Disconnect()
		PermanentConnections[player] = nil
	end
end)

--==================================================
-- ESP REFRESH
--==================================================

task.spawn(function()
	while Gui.Parent do
		if IsESP() then
			UpdateESP()
		end

		for player in pairs(PermanentPlayers) do
			if player.Parent == Players then
				ApplyPermanentHighlight(player)
			end
		end

		task.wait(0.25)
	end
end)

