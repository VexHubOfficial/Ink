Section("👁️ ESP")

local ESPButton, IsESP =
	Toggle("ESP ALL PLAYERS")

local function GetTeamColor(Player)

	-- No team = red
	if Player.Team == nil then
		return RED
	end

	-- Determine whether there is actually
	-- more than one team in the server.
	local DifferentTeam = false

	for _, Other in ipairs(Players:GetPlayers()) do

		if Other ~= Player
			and Other.Team ~= nil
			and Other.Team ~= Player.Team then

			DifferentTeam = true
			break

		end
	end

	if not DifferentTeam then
		return RED
	end

	return Player.TeamColor.Color
end

local function IsPermanent(Player)
	return PermanentPlayers[Player] == true
end

local function RemoveNormalHighlight(Player)

	local Character = Player.Character

	if not Character then
		return
	end

	local Highlight =
		Character:FindFirstChild("MalevolentESP")

	if Highlight then
		Highlight:Destroy()
	end
end

local function ApplyNormalHighlight(Player)

	if Player == LocalPlayer then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	-- Permanent purple always overrides ESP
	if IsPermanent(Player) then
		RemoveNormalHighlight(Player)
		return
	end

	local Existing =
		Character:FindFirstChild("MalevolentESP")

	if not Existing then

		Existing = Instance.new("Highlight")
		Existing.Name = "MalevolentESP"
		Existing.Adornee = Character
		Existing.FillTransparency = 0.5
		Existing.OutlineTransparency = 0
		Existing.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		Existing.Parent = Character

	end

	local Color = GetTeamColor(Player)

	Existing.FillColor = Color
	Existing.OutlineColor = Color
end

local function UpdateESP()

	for _, Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer then

			if IsESP() then
				ApplyNormalHighlight(Player)
			else
				RemoveNormalHighlight(Player)
			end

		end

	end
end

-- Update continuously so respawns/team changes
-- are automatically handled.
RunService.Heartbeat:Connect(function()

	if IsESP() then
		UpdateESP()
	end

end)

