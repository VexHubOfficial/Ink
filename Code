-- FLY TO ALL
--==================================================

flyAll.MouseButton1Click:Connect(function()

	task.spawn(function()

		local parts = getParts()

		for _, part in ipairs(parts) do

			if not part or not part.Parent then
				continue
			end

			flyToPart(part)

			-- Tiny pause before selecting the next part.
			task.wait(0.05)
		end
	end)
end)

--==================================================
-- FLY TO CLOSEST
--==================================================

closest.MouseButton1Click:Connect(function()

	task.spawn(function()

		local root = getRoot()

		if not root then
			return
		end

		local closestPart
		local closestDistance = math.huge

		for _, part in ipairs(getParts()) do

			if part and part.Parent then

				local distance =
					(part.Position -
						root.Position).Magnitude

				if distance < closestDistance then

					closestDistance =
						distance

					closestPart =
						part

				end
			end
		end

		if closestPart then
			flyToPart(closestPart)
		end
	end)
end)

