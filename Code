Section("👁️ ESP HIGHLIGHTS")

local ESPBox =
	TextBox("Display name prefix...")

local HighlightButton =
	Button("HIGHLIGHT PLAYER")

local RemoveHighlightButton =
	Button("REMOVE HIGHLIGHT")

local function GetHighlightColor(Player)

	-- No team = red
	if Player.Team == nil then
		return RED
	end

	-- If everybody is on the same team, use red
	local HasDifferentTeam = false

	for _, Other in ipairs(Players:GetPlayers()) do

		if Other ~= LocalPlayer
			and Other.Team ~= nil
			and Other.Team ~= Player.Team then

			HasDifferentTeam = true
			break
		end
	end

	if not HasDifferentTeam then
		return RED
	end

	return Player.TeamColor.Color
end

local function AddHighlight(Player, Color)

	local Character = Player.Character

	if not Character then
		return
	end

	local Existing =
		Character:FindFirstChild("MalevolentHighlight")

	if Existing then
		Existing.FillColor = Color
		return Existing
	end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "MalevolentHighlight"
	Highlight.Adornee = Character
	Highlight.FillColor = Color
	Highlight.OutlineColor = Color
	Highlight.FillTransparency = 0.5
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Parent = Character

	return Highlight
end

local function RemoveHighlight(Player)

	local Character = Player.Character

	if not Character then
		return
	end

	local Highlight =
		Character:FindFirstChild("MalevolentHighlight")

	if Highlight then
		Highlight:Destroy()
	end
end

HighlightButton.MouseButton1Click:Connect(function()

	local Target = FindPlayer(ESPBox.Text)

	if Target then
		AddHighlight(Target, GetHighlightColor(Target))
	end
end)

RemoveHighlightButton.MouseButton1Click:Connect(function()

	local Target = FindPlayer(ESPBox.Text)

	if Target then
		RemoveHighlight(Target)
	end
end)

