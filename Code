local function Button(Text)
	local B = Instance.new("TextButton")
	B.Size = UDim2.new(1, -5, 0, 38)
	B.BackgroundColor3 = DARK_RED
	B.BorderSizePixel = 0
	B.Text = Text
	B.TextColor3 = WHITE
	B.TextSize = 14
	B.Font = Enum.Font.GothamBold
	B.AutoButtonColor = false
	B.Parent = Content

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = B

	B.MouseEnter:Connect(function()
		TweenService:Create(
			B,
			TweenInfo.new(0.12),
			{BackgroundColor3 = HOVER}
		):Play()
	end)

	B.MouseLeave:Connect(function()
		TweenService:Create(
			B,
			TweenInfo.new(0.12),
			{BackgroundColor3 = DARK_RED}
		):Play()
	end)

	return B
end

local function Toggle(Text)
	local B = Instance.new("TextButton")
	B.Size = UDim2.new(1, -5, 0, 38)
	B.BackgroundColor3 = ELEMENT
	B.BorderSizePixel = 0
	B.Text = Text .. "  [ OFF ]"
	B.TextColor3 = WHITE
	B.TextSize = 14
	B.Font = Enum.Font.GothamBold
	B.AutoButtonColor = false
	B.Parent = Content

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = B

	local Enabled = false

	B.MouseButton1Click:Connect(function()
		Enabled = not Enabled

		if Enabled then
			B.Text = Text .. "  [ ON ]"
			B.BackgroundColor3 = RED
		else
			B.Text = Text .. "  [ OFF ]"
			B.BackgroundColor3 = ELEMENT
		end
	end)

	return B, function()
		return Enabled
	end
end

