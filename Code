--==================================================
-- ROOT
--==================================================

local function getRoot()

	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)
end

--==================================================
-- CLEAR HIGHLIGHTS
--==================================================

local function clearHighlights()

	for _, highlight in ipairs(highlights) do

		if highlight
			and highlight.Parent then

			highlight:Destroy()
		end
	end

	table.clear(highlights)
end

--==================================================
-- GET MATCHING PARTS WITHIN 500
--==================================================

local function scanIncludedParts()

	local root = getRoot()

	if not root then
		return {}
	end

	if box.Text == "" then
		return {}
	end

	local result = {}

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			and object.Name == box.Text then

			local distance =
				(object.Position - root.Position).Magnitude

			if distance <= INCLUDE_DISTANCE then
				table.insert(result, object)
			end
		end
	end

	return result
end

--==================================================
-- APPLY PURPLE HIGHLIGHTS
--==================================================

local function refreshHighlights()

	clearHighlights()

	if not highlightEnabled then
		return
	end

	for _, part in ipairs(includedParts) do

		if part and part.Parent then

			local h =
				Instance.new("Highlight")

			h.Name =
				"PartBringerIncluded"

			h.Adornee =
				part

			h.FillColor =
				highlightColor

			h.OutlineColor =
				highlightColor

			h.FillTransparency = 0.5
			h.OutlineTransparency = 0

			h.DepthMode =
				Enum.HighlightDepthMode.AlwaysOnTop

			h.Parent = part

			table.insert(highlights, h)
		end
	end
end

