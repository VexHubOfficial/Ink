local function FindPart(name)
	if name == "" then
		return nil
	end

	local wanted = string.lower(name)

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			if string.lower(obj.Name) == wanted then
				return obj
			end
		end
	end

	return nil
end

