CreateSection("👁️ ESP")

local ESPButton, IsESP =
	CreateToggle("ESP ALL PLAYERS")

local function RemoveESPHighlight(player)
	local character = player.Character

	if not character then
		return
	end

	local highlight =
		character:FindFirstChild("MalevolentESP")

	if highlight then
		highlight:Destroy()
	end
end

local function GetESPColor(player)
	-- No team = RED
	if player.Team == nil then
		return RED
	end

	-- Determine whether there are multiple teams
	local teamCount = 0
	local foundTeams = {}

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= LocalPlayer and other.Team ~= nil then
			if not foundTeams[other.Team] then
				foundTeams[other.Team] = true
				teamCount += 1
			end
		end
	end

	-- Everyone is on the same team
	if teamCount <= 1 then
		return RED
	end

	return player.TeamColor.Color
end

local function ApplyESPHighlight(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	-- Permanent purple always overrides normal ESP
	if PermanentPlayers[player] then
		RemoveESPHighlight(player)
		return
	end

	local highlight =
		character:FindFirstChild("MalevolentESP")

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "MalevolentESP"
		highlight.Adornee = character
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
	end

	local color = GetESPColor(player)

	highlight.FillColor = color
	highlight.OutlineColor = color
end

local function UpdateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if IsESP() then
				ApplyESPHighlight(player)
			else
				RemoveESPHighlight(player)
			end
		end
	end
end

ESPButton.MouseButton1Click:Connect(function()
	-- Give the button a moment to update its state
	task.defer(UpdateESP)
end)

