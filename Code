--==================================================
-- GET CHARACTER ROOT
--==================================================

local function getRoot()
	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- GET PARTS WITHIN 500 STUDS
--==================================================

local function getParts()
	local root = getRoot()

	if not root then
		return {}
	end

	local wantedName = box.Text

	if wantedName == "" then
		return {}
	end

	local parts = {}

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			and object.Name == wantedName then

			local distance =
				(object.Position - root.Position).Magnitude

			if distance <= INCLUDE_DISTANCE then
				table.insert(parts, object)
			end
		end
	end

	return parts
end

--==================================================
-- HIGHLIGHT CLEANUP
--==================================================

local function clearHighlights()

	for _, highlight in ipairs(highlights) do

		if highlight
			and highlight.Parent then

			highlight:Destroy()
		end
	end

	table.clear(highlights)
end

--==================================================
-- AUTO PURPLE HIGHLIGHTS
--==================================================

local function updateHighlights()

	clearHighlights()

	if not highlightEnabled then
		return
	end

	for _, part in ipairs(getParts()) do

		if part and part.Parent then

			local highlight =
				Instance.new("Highlight")

			highlight.Name =
				"PartBringerPurpleHighlight"

			highlight.Adornee =
				part

			highlight.FillColor =
				highlightColor

			highlight.OutlineColor =
				highlightColor

			highlight.FillTransparency =
				0.5

			highlight.OutlineTransparency =
				0

			highlight.DepthMode =
				Enum.HighlightDepthMode.AlwaysOnTop

			highlight.Parent =
				part

			table.insert(
				highlights,
				highlight
			)
		end
	end
end

