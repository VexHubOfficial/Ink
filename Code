--==================================================
-- BRING ALL PARTS TO PLAYER
--==================================================

bringAll.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	local parts = getParts()

	if #parts == 0 then
		return
	end

	for _, part in ipairs(parts) do

		if part and part.Parent then
			part.Anchored = false
		end

	end

	task.spawn(function()

		local startTime = os.clock()

		while os.clock() - startTime < bringDuration do

			if not root.Parent then
				break
			end

			for _, part in ipairs(parts) do

				if part and part.Parent then

					part.Anchored = false

					local offset =
						root.Position - part.Position

					local distance =
						offset.Magnitude

					if distance > 3 then

						part.AssemblyLinearVelocity =
							offset.Unit *
							math.min(
								distance * 10,
								bringSpeed
							)

					else

						part.AssemblyLinearVelocity =
							Vector3.zero

					end

					part.AssemblyAngularVelocity =
						Vector3.zero
				end

			end

			RunService.Heartbeat:Wait()
		end
	end)
end)

--==================================================
-- BRING PLAYER TO ALL PARTS
--==================================================

bringMeAll.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	local parts = getParts()

	for _, part in ipairs(parts) do

		if part and part.Parent then

			root.CFrame =
				part.CFrame +
				Vector3.new(0, 3, 0)

			RunService.Heartbeat:Wait()
		end

	end
end)

--==================================================
-- BRING PLAYER TO CLOSEST
--==================================================

closest.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	local closestPart = nil
	local closestDistance = math.huge

	for _, part in ipairs(getParts()) do

		if part and part.Parent then

			local distance =
				(part.Position - root.Position).Magnitude

			if distance < closestDistance then

				closestDistance = distance
				closestPart = part

			end
		end
	end

	if closestPart then

		root.CFrame =
			closestPart.CFrame +
			Vector3.new(0, 3, 0)

	end
end)

