--==================================================
-- RENDER CHECK
--==================================================

local function isRendered(part)
	if not camera then
		camera = workspace.CurrentCamera
	end

	if not camera or not part then
		return false
	end

	local viewportPoint, onScreen =
		camera:WorldToViewportPoint(part.Position)

	if not onScreen then
		return false
	end

	if viewportPoint.Z <= 0 then
		return false
	end

	-- Basic visibility/range check.
	-- This determines whether the part's position is
	-- currently inside the camera's view.
	return true
end

--==================================================
-- GET MATCHING PARTS
--==================================================

local function getParts()
	local wantedName = box.Text

	if wantedName == "" then
		return {}
	end

	local parts = {}

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart")
			and object.Name == wantedName then

			if excludeRendered then
				if not isRendered(object) then
					table.insert(parts, object)
				end
			else
				table.insert(parts, object)
			end
		end
	end

	return parts
end

--==================================================
-- CLIENT UNANCHOR
--==================================================

local function unanchorParts()
	for _, part in ipairs(getParts()) do
		if part and part.Parent then
			part.Anchored = false
		end
	end
end

