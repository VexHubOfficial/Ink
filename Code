local function Button(text)
	local B = Instance.new("TextButton")
	B.Size = UDim2.new(1, -5, 0, 40)
	B.BackgroundColor3 = Color3.fromRGB(45, 10, 10)
	B.BorderSizePixel = 0
	B.Text = text
	B.TextColor3 = Color3.fromRGB(255, 255, 255)
	B.TextSize = 14
	B.Font = Enum.Font.GothamBold
	B.AutoButtonColor = false
	B.Parent = Content

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = B

	B.MouseEnter:Connect(function()
		TweenService:Create(
			B,
			TweenInfo.new(0.15),
			{BackgroundColor3 = Color3.fromRGB(75, 12, 12)}
		):Play()
	end)

	B.MouseLeave:Connect(function()
		TweenService:Create(
			B,
			TweenInfo.new(0.15),
			{BackgroundColor3 = Color3.fromRGB(45, 10, 10)}
		):Play()
	end)

	return B
end

local function Toggle(text)
	local B = Instance.new("TextButton")
	B.Size = UDim2.new(1, -5, 0, 40)
	B.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	B.BorderSizePixel = 0
	B.Text = text .. "  [ OFF ]"
	B.TextColor3 = Color3.fromRGB(240, 240, 240)
	B.TextSize = 14
	B.Font = Enum.Font.GothamBold
	B.AutoButtonColor = false
	B.Parent = Content

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = B

	local Enabled = false

	B.MouseButton1Click:Connect(function()
		Enabled = not Enabled

		if Enabled then
			B.Text = text .. "  [ ON ]"
			B.BackgroundColor3 = Color3.fromRGB(130, 10, 10)
		else
			B.Text = text .. "  [ OFF ]"
			B.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
		end
	end)

	return B, function()
		return Enabled
	end
end

