--==================================================
-- GET ROOT
--==================================================

local function getRoot()
	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- GET MATCHING PARTS
--==================================================

local function getParts()
	local wantedName = box.Text

	if wantedName == "" then
		return {}
	end

	local parts = {}

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			and object.Name == wantedName
			and not excludedParts[object] then

			table.insert(parts, object)
		end
	end

	return parts
end

--==================================================
-- EXCLUDE RENDERED PARTS
--==================================================
-- ONE-TIME ACTION:
-- Finds matching parts within 100 studs and
-- permanently excludes them from this session.

excludeButton.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	local wantedName = box.Text

	if wantedName == "" then
		return
	end

	local excludedCount = 0

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			and object.Name == wantedName then

			local distance =
				(object.Position - root.Position).Magnitude

			if distance <= renderDistance
				and not excludedParts[object] then

				excludedParts[object] = true
				excludedCount += 1
			end
		end
	end

	-- Visual confirmation only.
	local oldText = excludeButton.Text

	excludeButton.Text =
		"Excluded " .. excludedCount .. " Parts"

	excludeButton.BackgroundColor3 =
		Color3.fromRGB(45, 45, 45)

	task.delay(1.2, function()

		if excludeButton.Parent then
			excludeButton.Text = oldText

			excludeButton.BackgroundColor3 =
				Color3.fromRGB(30, 30, 30)
		end

	end)

	if highlightEnabled then
		updateHighlights()
	end
end)

--==================================================
-- CLIENT UNANCHOR
--==================================================

local function unanchorParts()

	for _, part in ipairs(getParts()) do

		if part and part.Parent then
			part.Anchored = false
		end

	end
end

unanchorButton.MouseButton1Click:Connect(function()

	unanchorEnabled = not unanchorEnabled

	unanchorButton.Text =
		"Client Unanchor  •  " ..
		(unanchorEnabled and "ON" or "OFF")

	if unanchorEnabled then
		unanchorParts()
	end
end)

--==================================================
-- HIGHLIGHTS
--==================================================

local highlights = {}

local function clearHighlights()

	for _, highlight in ipairs(highlights) do

		if highlight and highlight.Parent then
			highlight:Destroy()
		end

	end

	table.clear(highlights)
end

function updateHighlights()

	clearHighlights()

	if not highlightEnabled then
		return
	end

	for _, part in ipairs(getParts()) do

		if part and part.Parent then

			local highlight = Instance.new("Highlight")

			highlight.Name = "PartBringerHighlight"
			highlight.Adornee = part
			highlight.FillColor = highlightColor
			highlight.OutlineColor = highlightColor
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.DepthMode =
				Enum.HighlightDepthMode.AlwaysOnTop

			highlight.Parent = part

			table.insert(highlights, highlight)
		end
	end
end

highlightButton.MouseButton1Click:Connect(function()

	highlightEnabled = not highlightEnabled

	highlightButton.Text =
		"Highlight Part  •  " ..
		(highlightEnabled and "ON" or "OFF")

	updateHighlights()
end)

