--==================================================
-- BRING ALL INCLUDED PARTS
--==================================================

bringAll.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	for _, part in ipairs(includedParts) do

		if part and part.Parent then

			part.Anchored = false

			local offset =
				root.Position - part.Position

			local distance =
				offset.Magnitude

			if distance > 2 then

				part.AssemblyLinearVelocity =
					offset.Unit *
					math.min(
						distance * 10,
						150
					)

				part.AssemblyAngularVelocity =
					Vector3.zero
			end
		end
	end
end)

--==================================================
-- FLY TO PART
--==================================================

local function flyToPart(part)

	local root = getRoot()

	if not root
		or not part
		or not part.Parent then

		return
	end

	local humanoid =
		root.Parent:FindFirstChildOfClass(
			"Humanoid"
		)

	local oldAutoRotate

	if humanoid then

		oldAutoRotate =
			humanoid.AutoRotate

		humanoid.AutoRotate =
			false
	end

	while root.Parent
		and part.Parent do

		local target =
			part.Position +
			Vector3.new(0, 3, 0)

		local offset =
			target - root.Position

		local distance =
			offset.Magnitude

		if distance <= 2 then
			break
		end

		local dt =
			RunService.Heartbeat:Wait()

		local step =
			math.min(
				TRAVEL_SPEED * dt,
				distance
			)

		local newPosition =
			root.Position +
			offset.Unit * step

		root.CFrame =
			CFrame.lookAt(
				newPosition,
				newPosition + offset.Unit
			)
	end

	if humanoid
		and humanoid.Parent then

		humanoid.AutoRotate =
			oldAutoRotate
	end
end

