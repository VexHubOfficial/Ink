--==================================================
-- CHARACTER
--==================================================

local function getRoot()
	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- PART SEARCH
--==================================================

local function getParts()
	local name = box.Text

	if name == "" then
		return {}
	end

	local result = {}

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			and object.Name == name
			and not excludedParts[object] then

			table.insert(result, object)
		end
	end

	return result
end

--==================================================
-- EXCLUDE RENDERED PARTS
--==================================================
-- ONE-TIME ACTION.
--
-- Any matching part within 10 studs of the player
-- is added to the excluded list.

excludeButton.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root or box.Text == "" then
		return
	end

	local count = 0

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("BasePart")
			and object.Name == box.Text then

			local distance =
				(object.Position - root.Position).Magnitude

			if distance <= EXCLUDE_DISTANCE
				and not excludedParts[object] then

				excludedParts[object] = true
				count += 1
			end
		end
	end

	local oldText = excludeButton.Text

	excludeButton.Text =
		"Excluded " .. count .. " Parts"

	task.delay(1.2, function()

		if excludeButton.Parent then
			excludeButton.Text = oldText
		end

	end)

	if highlightEnabled then
		updateHighlights()
	end
end)

--==================================================
-- UNANCHOR
--==================================================

local function unanchorParts()

	for _, part in ipairs(getParts()) do

		if part and part.Parent then
			part.Anchored = false
		end

	end
end

unanchorButton.MouseButton1Click:Connect(function()

	unanchorEnabled =
		not unanchorEnabled

	unanchorButton.Text =
		"Client Unanchor  •  " ..
		(unanchorEnabled and "ON" or "OFF")

	if unanchorEnabled then
		unanchorParts()
	end
end)

--==================================================
-- HIGHLIGHTS
--==================================================

local function clearHighlights()

	for _, highlight in ipairs(highlights) do

		if highlight and highlight.Parent then
			highlight:Destroy()
		end

	end

	table.clear(highlights)
end

function updateHighlights()

	clearHighlights()

	if not highlightEnabled then
		return
	end

	for _, part in ipairs(getParts()) do

		if part and part.Parent then

			local highlight =
				Instance.new("Highlight")

			highlight.Name =
				"PartBringerHighlight"

			highlight.Adornee =
				part

			highlight.FillColor =
				HIGHLIGHT_COLOR

			highlight.OutlineColor =
				HIGHLIGHT_COLOR

			highlight.FillTransparency =
				0.5

			highlight.DepthMode =
				Enum.HighlightDepthMode.AlwaysOnTop

			highlight.Parent =
				part

			table.insert(
				highlights,
				highlight
			)
		end
	end
end

highlightButton.MouseButton1Click:Connect(function()

	highlightEnabled =
		not highlightEnabled

	highlightButton.Text =
		"Highlight Part  •  " ..
		(highlightEnabled and "ON" or "OFF")

	updateHighlights()
end)

