--==================================================
-- BRING ALL PARTS TO PLAYER
--==================================================

bringAll.MouseButton1Click:Connect(function()

	local root = getRoot()

	if not root then
		return
	end

	local parts = getParts()

	if #parts == 0 then
		return
	end

	for _, part in ipairs(parts) do

		if part and part.Parent then

			part.Anchored = false

			local offset =
				root.Position - part.Position

			if offset.Magnitude > 2 then

				part.AssemblyLinearVelocity =
					offset.Unit *
					math.min(
						offset.Magnitude * 10,
						BRING_SPEED
					)
			end
		end
	end
end)

--==================================================
-- FLY TO ONE PART
--==================================================
-- Moves the character directly through the air.
-- Speed is approximately 24 studs per second.

local function flyToPart(part)

	local root = getRoot()

	if not root or not part or not part.Parent then
		return false
	end

	local humanoid =
		root.Parent:FindFirstChildOfClass("Humanoid")

	-- Keep the character from fighting the local
	-- flight movement.

	local oldAutoRotate

	if humanoid then
		oldAutoRotate =
			humanoid.AutoRotate

		humanoid.AutoRotate =
			false
	end

	while root.Parent and part.Parent do

		local target =
			part.Position +
			Vector3.new(0, 3, 0)

		local offset =
			target - root.Position

		local distance =
			offset.Magnitude

		if distance <= 2 then
			break
		end

		local dt =
			RunService.Heartbeat:Wait()

		local step =
			math.min(
				TRAVEL_SPEED * dt,
				distance
			)

		local newPosition =
			root.Position +
			offset.Unit * step

		-- Face the direction we're flying.
		if offset.Magnitude > 0.01 then

			root.CFrame =
				CFrame.lookAt(
					newPosition,
					newPosition + offset.Unit
				)

		else

			root.CFrame =
				CFrame.new(newPosition)
		end
	end

	if humanoid and humanoid.Parent then
		humanoid.AutoRotate =
			oldAutoRotate
	end

	return true
end

